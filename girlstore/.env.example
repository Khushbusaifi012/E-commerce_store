# Copy to .env (same folder as manage.py). Never commit .env.
#
# Local: MySQL — pip install -r requirements.txt && pip install -r requirements-dev.txt
# Render: SQLite only (RENDER=true); do not set DATABASE_URL on the service.

SECRET_KEY=generate-a-new-secret-for-production

# Local dev: turn debug on
DEBUG=True

# --- MySQL (always used when RENDER is not true / local dev) ---
MYSQL_DATABASE=girlstore
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Production / Render: comma-separated hosts if needed (Render also auto-adds host when RENDER=true)
# ALLOWED_HOSTS=https://e-commerce-store-paphp.onrender.com/

# --- Optional: bootstrap Django admin on first deploy (no Shell on Render Free) ---
# Set all three on Render Environment, add to Start Command after migrate:
#   python manage.py ensure_superuser
# Remove DJANGO_SUPERUSER_PASSWORD after first successful deploy if you prefer.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-secret
# If that user already exists but password is wrong: set once, deploy, then remove:
# DJANGO_SUPERUSER_SYNC_PASSWORD=1
