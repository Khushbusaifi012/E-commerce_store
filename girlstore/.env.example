# Copy to .env (same folder as manage.py). Never commit .env.
#
# Local: MySQL — pip install -r requirements.txt && pip install -r requirements-dev.txt
# Render: SQLite only (RENDER=true); do not set DATABASE_URL on the service.

SECRET_KEY=generate-a-new-secret-for-production

# Local dev: turn debug on
DEBUG=True

# --- MySQL (always used when RENDER is not true / local dev) ---
MYSQL_DATABASE=girlstore
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Production / Render: comma-separated hosts if needed (Render also auto-adds host when RENDER=true)
# ALLOWED_HOSTS=your-app.onrender.com
